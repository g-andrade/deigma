% -*- mode: erlang; -*- vim: set ft=erlang:
[
    {config, [
        #{
            files => ["src/**/*.erl"],
            ruleset => erl_files,
            rules => [
                % The time-span constants are function-style macros (?time_span(),
                % ?ms_time_span(), ?native_time_span()) and are intentionally
                % lowercase to read like the functions they stand in for.
                {elvis_style, macro_naming_convention, #{
                    regex => "^([A-Z](_?[A-Z0-9]+)*|[a-z](_?[a-z0-9]+)*)$"
                }},
                % decision/0 and friends are internal types used only in the specs
                % of the internal (-moduledoc false) event-window module; exporting
                % them would misrepresent them as part of the public API.
                {elvis_style, export_used_types, disable},
                % ask/4 blocks on a monitor-guarded reply (the 'DOWN' clause
                % guarantees liveness), so an 'after' clause would be spurious.
                {elvis_style, no_receive_without_timeout, #{
                    ignore => [deigma_event_window]
                }}
            ]
        },
        #{
            files => ["test/**/*.erl"],
            ruleset => erl_files,
            rules => [
                {elvis_style, no_debug_call, disable},
                {elvis_style, no_receive_without_timeout, disable},
                {elvis_style, dont_repeat_yourself, disable}
            ]
        },
        #{
            files => ["rebar.config", "elvis.config"],
            ruleset => rebar_config
        }
    ]}
].
