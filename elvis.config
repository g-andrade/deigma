% -*- mode: erlang; -*- vim: set ft=erlang:
[
    {config, [
        #{
            files => ["src/**/*.erl"],
            ruleset => erl_files,
            rules => [
                % state/0 and friends are internal record types referenced only by
                % @private OTP sys/proc_lib callbacks; exporting them would
                % misrepresent them as part of the public API.
                {elvis_style, export_used_types, disable},
                % wait/ask receives block on a monitor-guarded reply (the 'DOWN'
                % clause guarantees liveness), so an 'after' clause would be spurious.
                {elvis_style, no_receive_without_timeout, #{
                    ignore => [deigma_event_window]
                }}
            ]
        },
        #{
            files => ["test/**/*.erl"],
            ruleset => erl_files,
            rules => [
                {elvis_style, no_debug_call, disable},
                {elvis_style, no_receive_without_timeout, disable},
                {elvis_style, dont_repeat_yourself, disable}
            ]
        },
        #{
            files => ["rebar.config", "elvis.config"],
            ruleset => rebar_config
        }
    ]}
].
